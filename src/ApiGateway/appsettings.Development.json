{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://localhost:5000/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5006/"
          }
        }
      }
    }
  }
}
