{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithThreadName",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errorlog-.json",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "retainedFileCountLimit": 90,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Audience": "Ecommerce",
    "Issuer": "Ecommerce",
    "ExpiresInMinutes": 30
  },
  "Account": {
    "RequireConfirmedEmail": false,
    "RefreshTokenLifetimeDays": 7,
    "EmailConfirmationTokenLifetimeHours": 24,
    "PasswordResetTokenLifetimeMinutes": 60
  },
  "AuthCookies": {
    "Domain": "",
    "SameSite": "None",
    "RefreshTokenPath": "/"
  },
  "TokenCleanup": {
    "IntervalMinutes": 60,
    "RevokedRefreshTokenRetentionDays": 7,
    "UsedOrExpiredUserTokenRetentionDays": 1
  }
}
