<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Every API has a top-level Program class in the global namespace; aliases keep them apart. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Identity\Identity.API\Identity.API.csproj" Aliases="IdentityApi" />
    <ProjectReference Include="..\..\..\src\Catalog\Catalog.API\Catalog.API.csproj" Aliases="CatalogApi" />
    <ProjectReference Include="..\..\..\src\Cart\Cart.API\Cart.API.csproj" Aliases="CartApi" />
    <ProjectReference Include="..\..\..\src\Ordering\Ordering.API\Ordering.API.csproj" Aliases="OrderingApi" />
    <ProjectReference Include="..\..\..\src\Payment\Payment.Processor\Payment.Processor.csproj" Aliases="PaymentApi" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

</Project>
